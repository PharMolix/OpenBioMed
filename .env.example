# LLM API Configuration
# =============================================================================
# Priority:
# 1. Explicit model parameter → Match by prefix (ignores API_KEY/API_URL)
#    Example: get_llm("claude-sonnet-4-20250514") uses Anthropic API
# 2. No model param + API_KEY/API_URL configured → Use custom LLM
#    Example: get_llm() with MODEL_NAME="deepseek-r1" uses API_KEY/API_URL
# 3. No model param + no API_KEY/API_URL → Match by MODEL_NAME prefix
#
# Model prefix → Provider mapping (for priority 1 & 3):
# - "claude-*" → Anthropic (uses ANTHROPIC_*)
# - "openai-*" → OpenAI (uses OPENAI_*)
# - "gemini-*" → Google Gemini (uses GEMINI_*)
# - "deepseek-*" → DeepSeek (uses DEEPSEEK_*)
# - "BioMedGPT*" → Local BioMedGPT model
# - Other → Custom/Self-hosted LLM (uses API_*)
# =============================================================================

# Custom/Self-hosted LLM (OpenAI-compatible API)
# Used for vLLM, Ollama, LocalAI, or any OpenAI-compatible API
# Only used when model is NOT explicitly passed to get_llm()
API_KEY="your_api_key_here"
API_URL="http://your-llm-server:port/v1"
MODEL_NAME="your_model_name"

# Anthropic Claude (only used if API_KEY/API_URL are NOT configured)
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_API_URL="https://api.anthropic.com"

# OpenAI GPT (only used if API_KEY/API_URL are NOT configured)
# OPENAI_API_KEY="your_openai_api_key"
# OPENAI_API_URL="https://api.openai.com/v1"

# Google Gemini (only used if API_KEY/API_URL are NOT configured)
# GEMINI_API_KEY="your_gemini_api_key"
# GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta"

# DeepSeek (only used if API_KEY/API_URL are NOT configured)
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_API_URL="https://api.deepseek.com"

# =============================================================================

# Alibaba Cloud IQS Configuration
# Used for web search functionality (WebSearchRequester)
# Get credentials from: https://iqs.console.aliyun.com/
ALIYUN_AK="your_access_key_id"
ALIYUN_SK="your_access_key_secret"
ALIYUN_ENDPOINT="iqs.cn-zhangjiakou.aliyuncs.com"

# PubChem API Key (optional, for increased rate limits)
# Get your key from: https://pubchem.ncbi.nlm.nih.gov/docs/pug-rest
PUBCHEM_API_KEY="your_pubchem_api_key"

# Optional: OSS Configuration (for report storage)
# Only required if using ReportGeneratorGeneral or ReportGeneratorSBDD
# Change BUCKET_NAME and ENDPOINT to match your actual OSS bucket
ACCESS_KEY_ID="your_oss_access_key_id"
ACCESS_KEY_SECRET="your_oss_access_key_secret"
BUCKET_NAME="your_bucket_name"
ENDPOINT="oss-cn-your-region.aliyuncs.com"

# Optional: Email Configuration (for sending reports)
# Only required if using ReportGeneratorGeneral or ReportGeneratorSBDD
# Example for Tencent Enterprise Mail: smtp.exmail.qq.com:465
# Example for Ali Enterprise Mail: smtp.mxhichina.com:465
# Example for Gmail: smtp.gmail.com:587
EMAIL_SERVER="your_smtp_server"
EMAIL_PORT="465"
EMAIL_SENDER="your_email@company.com"
EMAIL_PASSWORD="your_email_password_or_auth_code"
